{
  "name": "line-splitter",
  "description": "Transform stream for line splitting",
  "version": "0.8.6",
  "author": "Codenautas <codenautas@googlegroups.com>",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "repository": "emilioplatzer/line-splitter",
  "contributors": [
    {
      "name": "Emilio Platzer",
      "email": "emilioplatzer@gmail.com"
    }
  ],
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.0.0",
    "discrepances": "^0.2.14",
    "mocha": "^12.0.0-rc.5",
    "nyc": "^18.0.0",
    "qa-control": "^0.7.5",
    "source-map-support": "^0.5.21",
    "typescript": "^7.0.2"
  },
  "main": "dist/server/line-splitter.js",
  "types": "dist/server/line-splitter.d.ts",
  "engines": {
    "node": ">= 22"
  },
  "scripts": {
    "tsc": "tsc",
    "test": "npm run build && mocha --reporter spec --bail --check-leaks --exit",
    "test-ci": "npm run build && nyc --reporter=lcov --reporter=text-summary --reporter=html mocha --exit --check-leaks",
    "build": "tsc -p tsconfig-server.json && tsc -p tsconfig-test.json",
    "build-without-err": "(tsc -p tsconfig-server.json || echo \"continue w/error\") && (tsc -p tsconfig-test.json  || echo \"continue w/error\")"
  },
  "nyc": {
    "extension": [
      ".js",
      ".ts"
    ],
    "exclude": [
      "**/*.d.ts",
      "src/test"
    ],
    "include": [
      "dist/**/*.js",
      "src/server/**"
    ],
    "reporter": [
      "html",
      "lcov",
      "text-summary"
    ],
    "sourceMap": true,
    "instrument": true,
    "all": true,
    "check-coverage": true
  },
  "qa-control": {
    "package-version": "0.3.0",
    "run-in": "server",
    "test-appveyor": true,
    "type": "lib",
    "stage": "designing",
    "coverage": 100,
    "gha": "all",
    "silenced": [
      "first_lines_does_not_match_in_file_1"
    ]
  }
}
